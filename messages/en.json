      "welcome": {
        "title": "Welcome",
        "description": "This tool helps you visualize and explore the platforms of the Quebec Digital Health Network (RSN). Navigate between four complementary views to discover the organizations, people, applications and datasets of the network.",
        "tip": "Use the search bar in the header to quickly find an entity. The advanced filters let you filter by type, domain and more."
      },
      "graph": {
        "title": "Graph view",
        "description": "The interactive graph shows the relationships between the entities of the network. Hold left-click to rotate the view, use the scroll wheel to zoom, and click a node to see its details.",
        "tip": "Each node type has its own color: blue for organizations, green for people, yellow for datasets, red for applications."
      },
      "cards": {
        "title": "Cards view",
        "description": "The cards summarize each entity with its key information. Click \"See more\" to access the full details: description, address, contact, grants and links.",
        "tip": "Cards are sorted alphabetically and the colored border matches the entity type."
      },
      "table": {
        "title": "Table view",
        "description": "The table lists all entities in a structured way, sorted alphabetically. Click a row to see the entity's full details.",
        "tip": "Combine search and filters to refine the results in the table."
      },
      "map": {
        "title": "Map view",
        "description": "The geographic map locates entities that have a physical address. Click a marker to see the entity summary and access its detail card.",
        "tip": "Purple markers indicate entity locations. The larger the marker, the more nearby entities it groups together."
      }
    }
